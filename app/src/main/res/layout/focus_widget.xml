<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="F O C U S" android:textColor="#EAEAF1" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:contentDescription="Открыть FOCUS"/>
  <TextView android:id="@+id/widget_calendar" android:layout_width="64dp" android:layout_height="match_parent" android:gravity="center" android:text="Дата" android:textColor="#9A9EAE" android:textSize="12sp" android:contentDescription="Календарь"/>
  <TextView android:id="@+id/widget_add" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textColor="#B7A7F4" android:textSize="28sp" android:contentDescription="Добавить задачу"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9A9EAE" android:textSize="11sp" android:paddingBottom="8dp" android:maxLines="2"/>
 <TextView android:id="@+id/widget_load" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B7A7F4" android:textSize="22sp" android:paddingTop="8dp" android:paddingBottom="16dp"/>
 <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:text="Все задачи  ›" android:textColor="#9A9EAE" android:textSize="11sp"/>
</LinearLayout>
